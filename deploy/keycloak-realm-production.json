{
  "realm": "ztemizinden",
  "displayName": "Maintly",
  "loginTheme": "maintly",
  "enabled": true,
  "internationalizationEnabled": true,
  "defaultLocale": "tr",
  "supportedLocales": [
    "tr",
    "en"
  ],
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "from": "${KEYCLOAK_SMTP_FROM}",
    "auth": "true",
    "user": "${KEYCLOAK_SMTP_USERNAME}",
    "password": "${KEYCLOAK_SMTP_PASSWORD}",
    "starttls": "true",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Customer portal access"
      },
      {
        "name": "SERVICE",
        "description": "Service provider portal access"
      },
      {
        "name": "ADMIN",
        "description": "Operations center access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ztemizinden-api",
      "name": "Maintly API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ztemizinden-web",
      "name": "Maintly Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_WEB_URL}/*"
      ],
      "webOrigins": [
        "${KEYCLOAK_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KEYCLOAK_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "Maintly API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ztemizinden-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "Customer domain id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customerId",
            "claim.name": "customerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "Provider domain id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "providerId",
            "claim.name": "providerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "ztemizinden-backend-admin",
      "name": "Maintly Backend Identity Provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-ztemizinden-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "ztemizinden-backend-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users",
          "view-realm"
        ]
      }
    }
  ]
}