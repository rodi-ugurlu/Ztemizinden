[Unit]
Description=Ztemizinden Spring Boot application
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=ztemizinden
Group=ztemizinden
WorkingDirectory=/opt/ztemizinden
EnvironmentFile=/etc/ztemizinden/ztemizinden.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/ztemizinden/ztemizinden.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ztemizinden /opt/ztemizinden

[Install]
WantedBy=multi-user.target
