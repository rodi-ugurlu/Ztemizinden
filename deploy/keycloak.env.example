# Store the real file at /etc/ztemizinden/keycloak.env with mode 600.
# Use independently generated values; never commit production secrets.
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-database-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=maintly-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# This exact value must also be KEYCLOAK_ADMIN_CLIENT_SECRET in
# /etc/ztemizinden/ztemizinden.env. Minimum 32 characters.
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-unique-32-character-minimum-secret

# Keycloak sends account setup and password reset messages itself.
KEYCLOAK_SMTP_HOST=smtp.example.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=noreply@example.com
KEYCLOAK_SMTP_USERNAME=noreply@example.com
KEYCLOAK_SMTP_PASSWORD=replace-with-the-real-smtp-password

# Maintly application admin account for /admin/login.
# This is not the Keycloak master admin; it is a ztemizinden realm user with
# the ADMIN role. Keep the password aligned with the realm password policy.
MAINTLY_ADMIN_EMAIL=admin@example.com
MAINTLY_ADMIN_PASSWORD=replace-with-a-long-random-admin-login-password
