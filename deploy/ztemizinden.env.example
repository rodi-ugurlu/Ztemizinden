SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_DEMO_ENSURE_ACCOUNTS=false
APP_DEMO_RESET_AND_SEED=false

DB_URL=jdbc:postgresql://127.0.0.1:5432/ztemizinden
DB_USERNAME=ztemizinden
DB_PASSWORD=change-me

APP_SECURITY_ENABLED=true
KEYCLOAK_ISSUER_URI=https://maintly.net/auth/realms/ztemizinden
KEYCLOAK_JWK_SET_URI=https://maintly.net/auth/realms/ztemizinden/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=ztemizinden-api
KEYCLOAK_REALM=ztemizinden
KEYCLOAK_WEB_CLIENT_ID=ztemizinden-web
KEYCLOAK_ADMIN_BASE_URL=https://maintly.net/auth
KEYCLOAK_ADMIN_CLIENT_ID=ztemizinden-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-this-to-a-unique-production-secret
KEYCLOAK_PASSWORD_RESET_REDIRECT_URI=https://maintly.net/customer/login
KEYCLOAK_MIGRATE_LEGACY_USERS=false
APP_UPLOAD_DIR=/var/lib/ztemizinden/uploads

# Same-origin traffic does not need CORS. Keep your domain here only if another
# frontend origin also needs to call this backend.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://maintly.net,https://www.maintly.net
