{
  "realm": "ztemizinden",
  "displayName": "Maintly",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "Customer portal access" },
      { "name": "SERVICE", "description": "Service provider portal access" },
      { "name": "ADMIN", "description": "Operations center access" }
    ]
  },
  "clients": [
    {
      "clientId": "ztemizinden-api",
      "name": "Maintly API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ztemizinden-web",
      "name": "Maintly Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*##http://localhost:8080/*##http://127.0.0.1:8080/*"
      },
      "protocolMappers": [
        {
          "name": "Maintly API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ztemizinden-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "Customer domain id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "customerId",
            "claim.name": "customerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "Provider domain id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "providerId",
            "claim.name": "providerId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "ztemizinden-backend-admin",
      "name": "Maintly Backend Identity Provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "ztemizinden-local-admin-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-ztemizinden-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "ztemizinden-backend-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-users"]
      }
    },
